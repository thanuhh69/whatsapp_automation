# Google Sheets Configuration
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Form Responses 1

# Phone Normalization
COUNTRY_CODE=91

# Messaging Pacing (seconds)
MIN_DELAY_SECONDS=8
MAX_DELAY_SECONDS=20

# WhatsApp Playwright Config
WHATSAPP_PROFILE_DIR=data/whatsapp-profile
WHATSAPP_HEADLESS=false

# Opt-out Settings
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE,CANCEL,REMOVE
INBOX_POLL_INTERVAL_SECONDS=90

# Operation Mode & API Security
TEST_MODE=true
API_TOKEN=
